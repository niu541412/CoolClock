{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDes__",
  "author": "Derek Leung",
  "version": "4.0.1",
  "icons": {
    "16": "icons/16x16.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_icon": "icons/16x16.png",
    "default_title": "Cool Clock",
    "default_popup": "new_popup2.html"
  },
  "background": {
    "service_worker": "mv3/worker.js"
  },
  "options_ui": {
    "page": "options_new.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "offscreen",
    "contextMenus",
    "tts",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "power"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://calendar.google.com/*"
  ],
  "minimum_chrome_version": "120",
  "offline_enabled": true,
  "default_locale": "en",
  "omnibox": {"keyword": "clock"}
}
